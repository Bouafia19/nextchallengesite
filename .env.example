# Next Challenge — Environment Configuration Template
# Production Domain: https://nextchallenge.tech

# Server & Port
PORT=5000

# MongoDB Database Configuration
# In production, provide your MongoDB Atlas cloud connection string:
# e.g. mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nextchallenge?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=nextchallenge

# Admin Dashboard Security
# Secret key used to access secured /api/admin/* endpoints (backend only, never expose to frontend)
ADMIN_API_KEY=

# Admin Portal Secret Route Path (server-side route gate, e.g. /administrator-<random-suffix>)
# Never hardcoded in frontend bundles; configured in Render environment variables
ADMIN_ROUTE_PATH=

# Target Inquiries Email (informational)
CONTACT_RECEIVER_EMAIL=nextchallenge2021@gmail.com

# Frontend Environment Variables (Vite)
VITE_CONTACT_API_URL=/api/contact

# Exact Live Product URLs
VITE_FLEETORA_URL=https://fleetora-web.onrender.com
VITE_INVENTORY_URL=https://inventory-v2-web-demo.onrender.com
VITE_TOURIVA_URL=https://touriva-web.onrender.com

# Social Media URLs
VITE_LINKEDIN_URL=https://www.linkedin.com/company/next-challenge-tech/
VITE_FACEBOOK_URL=https://www.facebook.com/profile.php?id=61575928927186
VITE_INSTAGRAM_URL=https://www.instagram.com/nextchallengetech/
