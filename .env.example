# Next Challenge — Environment Configuration
# Production Domain: https://nextchallenge.tech

# Server & Port
PORT=5000

# Target Inquiries Email
CONTACT_RECEIVER_EMAIL=nextchallenge2021@gmail.com

# SMTP Server Credentials (for server/server.js)
# Example for Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-google-app-password
# SMTP_FROM="Next Challenge" <nextchallenge2021@gmail.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Frontend Environment Variables (Vite)
# Contact form endpoint (defaults to /api/contact relative to host)
VITE_CONTACT_API_URL=/api/contact

# Exact Live Product URLs
VITE_FLEETORA_URL=https://fleetora-web.onrender.com
VITE_INVENTORY_URL=https://inventory-v2-web-demo.onrender.com
VITE_TOURIVA_URL=https://touriva-web.onrender.com

# Social Media URLs (Set exact company profile URLs)
VITE_FACEBOOK_URL=
VITE_INSTAGRAM_URL=
VITE_LINKEDIN_URL=
